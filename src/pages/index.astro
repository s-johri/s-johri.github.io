---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Saurabh Johri">
	<header>
		<h1>Saurabh Johri</h1>
		<p class="muted tagline">Backend software engineer. Python/Django &amp; Go on education platforms.</p>
		<p class="links">
			<a href="/resume.pdf">Resume (PDF)</a>
			<a href="https://github.com/s-johri">GitHub</a>
			<a href="https://www.linkedin.com/in/s-johri">LinkedIn</a>
		</p>
	</header>

	<section id="about" class="reveal section">
		<h2 class="section-label">About</h2>
		<div>
			<p>
				Django and Go engineer at Code Argo, on the BITS Pilani education platform: a student
				portal with ~180,000 users and ~75,000 active students. Streaming exports, daily ETL
				pipelines, certificate microservices, and API proxies in production, with an AI-assisted
				development workflow. MS in Artificial Intelligence from Boston University. Two feature
				PRs merged upstream into <a href="https://github.com/signintech/gopdf">gopdf</a>, a
				~2,900-star Go PDF library.
			</p>
		</div>
	</section>

	<section id="experience" class="reveal section">
		<h2 class="section-label">Experience</h2>
		<article>
			<div class="role">
				<h3>Software Engineer, Code Argo</h3>
				<span class="dates">May 2024 &ndash; Present</span>
			</div>
			<p class="muted org">Python/Django and Go engineering for the BITS Pilani ecosystem &middot; Remote</p>
			<ul>
				<li>
					Main engineer for new features on <strong>elearn</strong>, a Django student portal with
					<strong>~180,000 total users</strong> (~75,000 active students); owned frontend development
					early in the engagement.
				</li>
				<li>
					Shipped an async/streaming CSV export for MGPA and student-evaluation datasets, scaling the export limit to <strong>2.5M rows</strong>.
				</li>
				<li>
					Added superuser impersonation (&ldquo;Log in as&rdquo;) with audit logging.
				</li>
				<li>
					Maintain and extend <strong>elearn-api-proxy</strong> (Go), a certificate/transcript
					generation microservice pulling program and degree data from an ERP
					student-status API, with <strong>52,000+ certificates and transcripts generated</strong>
					to date.
				</li>
				<li>
					Built <strong>attendance-sync</strong> (Go), a daily ETL data pipeline parsing
					course-meeting attendance dumps from a Microsoft API into elearn, with
					<strong>1.3M+ attendance records processed</strong> to date.
				</li>
				<li>
					Developed <strong>discordbot-go</strong>, a Discord/Google account-linking gate bot for a
					<strong>~250-member</strong> community, with a self-healing reconciliation sweep that
					corrects membership drift.
				</li>
				<li>
					Co-built <strong>argo-api-proxy</strong> (Go/Fiber) with API-key request
					authentication, config-driven routing, and hot config reload; replaced in-memory
					query buffering with streamed response execution.
				</li>
			</ul>
		</article>
	</section>

	<section id="projects" class="reveal section">
		<h2 class="section-label">Projects</h2>
		<ul class="project-list">
			{projects.map((project) => (
				<li class={project.data.featured ? 'featured' : undefined}>
					<div class="project-title">
						<a href={`/projects/${project.id}`}>{project.data.title}</a>
						<span class="badge">{project.data.kind === 'case-study' ? 'Case study' : 'Open source'}</span>
						{project.data.featured && <span class="badge accent">Merged upstream</span>}
					</div>
					<p class="muted">{project.data.summary}</p>
				</li>
			))}
		</ul>
	</section>
</Base>

<style>
	.tagline {
		margin: 0 0 1.25rem;
		font-size: 1.1rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin: 0;
		font-family: var(--mono);
		font-size: 0.8rem;
		letter-spacing: 0.02em;
	}
	.role {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}
	.role h3 {
		margin: 0;
	}
	.dates {
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--muted);
		white-space: nowrap;
	}
	.org {
		margin: 0.25rem 0 1rem;
	}
	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.project-list li {
		margin: 0;
		padding: 1.1rem 0;
	}
	.project-list li + li {
		border-top: 1px solid var(--border);
	}
	.project-list li:first-child {
		padding-top: 0;
	}
	/* the one merged-upstream contribution: a hairline accent rule and a
	   whisper of surface tint. Enough to notice, not enough to shout. */
	.project-list li.featured {
		padding: 1.1rem 0 1.1rem 1rem;
		margin-left: -1rem;
		border-left: 2px solid var(--accent);
		background: linear-gradient(90deg, var(--surface), transparent 70%);
	}
	.project-list li.featured:first-child {
		padding-top: 0.9rem;
	}
	.badge.accent {
		color: var(--accent);
		border-color: var(--accent);
	}
	.project-title {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.6rem;
	}
	.project-title a {
		font-weight: 600;
	}
	.project-list p {
		margin: 0.35rem 0 0;
		font-size: 0.95rem;
	}
</style>
